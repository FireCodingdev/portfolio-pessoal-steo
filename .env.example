# ============================================
# Variáveis de ambiente do CRM do Portfólio
# ============================================
# Copie este arquivo para ".env.local" para rodar localmente,
# ou configure os mesmos nomes em Vercel > Project > Settings > Environment Variables.

# --- Banco de dados ---
# Gerado automaticamente quando você cria um "Postgres" na aba "Storage"
# do seu projeto na Vercel e o conecta a este projeto. Não precisa preencher
# manualmente em produção — a Vercel injeta essas variáveis sozinha.
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# --- Autenticação do painel administrativo ---
# Usados apenas no PRIMEIRO login para criar o administrador no banco.
# Depois disso, a senha pode ser trocada dentro do próprio painel (Configurações).
ADMIN_EMAIL="stefany@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Chave secreta usada para assinar o cookie de login. Use uma string
# longa e aleatória (pode gerar em https://generate-secret.vercel.app/32
# ou rodando: openssl rand -base64 32)
JWT_SECRET="troque-por-uma-string-aleatoria-bem-grande"
